    "eew.note.acceleration.format" : {
      "comment" : "TREM note: observed acceleration raised the estimate; %@ is the intensity",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strong acceleration detected, so the estimate is %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きな加速度を検知したため、予想震度は %@ です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 가속도가 감지되어 예상 진도는 %@입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因检测到较大的加速度，故预估震度 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因檢測到較大的加速度，故預估震度 %@。"
          }
        }
      }
    },
    "eew.note.alertIssued" : {
      "comment" : "TREM note: a warning was issued",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An earthquake early warning has been issued. Expect strong shaking."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急地震速報が発表されました。強い揺れに警戒してください。"
