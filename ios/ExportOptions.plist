<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options for the TestFlight build (.github/workflows/release-internal.yml).

  Committed rather than generated because CI does its own archive/export instead
  of `flutter build ipa`: Flutter passes `-allowProvisioningUpdates` but never
  the App Store Connect authentication flags, so on a runner with no signed-in
  Xcode account there is nothing for automatic signing to authenticate as. The
  workflow calls xcodebuild directly with `-authenticationKeyPath` and friends,
  and that path needs a plist of its own.

  `signingStyle: automatic` is what makes the API key do the work — Xcode
  creates or fetches the distribution certificate and the App Store profile for
  this team. That is why the key has to be an Admin key: Certificates,
  Identifiers & Profiles is a separate permission area that App Manager cannot
  reach.

  `method: app-store-connect` is the Xcode 15.4+ spelling of the old
  `app-store`. GitHub's macOS runners are well past that; on anything older
  xcodebuild rejects the value and the old name has to come back.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>98Q7JARYZF</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
