<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact (square) layout: a source-for-source restatement of iOS
  `SmallCurrentWeatherView` (`ios/DPIPWidgets/DPIPWidgets.swift`, lines
  177–283) — the town at the top leading edge, the condition glyph above its
  name at the top trailing edge, the 42 pt temperature low on the leading edge,
  and the humidity and rainfall readings on the bottom edge.

  Unlike iOS's fixed square family Android can be narrow and very tall. Keep
  the complete information cluster vertically balanced, not a full-height
  Spacer that separates the observation and temperature by hundreds of dp.

  Two adaptations the iOS layout does not need:

  * The HH:mm observation time keeps its own row under the town, so the
    condition block cannot squeeze the time out of a narrow launcher cell.
  * The town and the condition name carry an autosize range instead of fixed
    points: iOS applies `minimumScaleFactor(0.8)`, and at 120 dp the two would
    otherwise ellipsise.

  The conditional refresh action shares the temperature row. When it is
  GONE, the temperature receives the entire width; no action slot is reserved.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="@dimen/widget_padding_small"
    tools:ignore="DisableBaselineAlignment,UselessLeaf,UseAppTint,UseCompoundDrawables">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            tools:ignore="NestedWeights">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UselessParent">
            <TextView
                android:id="@+id/widget_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="@dimen/widget_text_headline"
                android:autoSizeMinTextSize="@dimen/widget_text_headline_min"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_text_headline"
                tools:ignore="NestedWeights" />

            <ImageView
                android:id="@+id/widget_location_icon"
                android:layout_width="@dimen/widget_icon_location"
                android:layout_height="@dimen/widget_icon_location"
                android:layout_marginStart="@dimen/widget_spacing_xs"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_location"
                android:visibility="gone"
                tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/widget_spacing_sm"
            android:gravity="end"
            android:orientation="vertical"
            tools:ignore="NestedWeights">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="@dimen/widget_icon_small"
                android:layout_height="@dimen/widget_icon_small"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/widget_text_caption2"
                android:autoSizeMinTextSize="@dimen/widget_text_caption2_min"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:maxWidth="@dimen/widget_weather_max_width"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_caption2" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_observation_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textColor="@color/widget_secondary"
        android:textSize="@dimen/widget_text_caption2" />

    <TextView
        android:id="@+id/widget_stale"
        style="@style/Widget.Badge"
        android:includeFontPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/widget_text_temperature_compact"
            android:autoSizeMaxTextSize="@dimen/widget_text_temperature"
            android:autoSizeStepGranularity="1sp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_text_temperature" />

        <FrameLayout
            android:id="@+id/widget_refresh"
            android:visibility="gone"
            android:layout_width="@dimen/widget_icon_action_touch_small"
            android:layout_height="@dimen/widget_icon_action_touch_small"
            android:contentDescription="@string/widget_refresh"
            android:padding="@dimen/widget_action_padding_small">
            <ImageView
                android:id="@+id/widget_refresh_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_refresh"
                android:tint="@color/widget_icon_tint" />
            <ProgressBar
                android:id="@+id/widget_refresh_progress"
                style="@style/Widget.RefreshProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_spacing_xs"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Each reading has a bounded budget, including its icon. A weighted
             spacer between wrap_content readings does not constrain either
             string: it can be negative while the last m is clipped by root. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_humidity"
                android:layout_width="@dimen/widget_icon_metric"
                android:layout_height="@dimen/widget_icon_metric"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_humidity" />

            <TextView
                android:id="@+id/widget_humidity_value"
                tools:ignore="NestedWeights"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_metric_gap"
                android:autoSizeMaxTextSize="@dimen/widget_text_caption"
                android:autoSizeMinTextSize="@dimen/widget_text_metric_min"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_rain"
                android:layout_width="@dimen/widget_icon_metric"
                android:layout_height="@dimen/widget_icon_metric"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_raindrop" />

            <TextView
                android:id="@+id/widget_rain_value"
                tools:ignore="NestedWeights"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_metric_gap"
                android:autoSizeMaxTextSize="@dimen/widget_text_caption"
                android:autoSizeMinTextSize="@dimen/widget_text_metric_min"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_caption" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
