<?xml version="1.0" encoding="utf-8"?>
<!--
  The large layout at the minimal height a launcher can report (~320 dp).

  The three section gaps use 2dp instead of 6dp, reserving complete hourly
  columns when the Android-only stale notice and refresh share the 320dp box.
  Keep the padded text, 28dp condition icon, detail grid and all five forecast
  columns; only decorative section space is recovered. The roomy layout and
  shared forecast items retain their own spacing and typography.

  `WidgetPresenter.largeRoomyMinimumHeightDp` selects this document below
  336 effective dp. Native first-draw and subsequent-measure coverage lives in
  `WidgetLargeTightForecastRegressionTest`.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="@dimen/widget_padding"
    tools:ignore="DisableBaselineAlignment,UselessLeaf,UseAppTint,UseCompoundDrawables">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UselessParent">
        <TextView
            android:id="@+id/widget_location"
            android:includeFontPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/widget_text_headline"
            android:autoSizeMinTextSize="@dimen/widget_text_headline_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_text_headline"
            tools:ignore="NestedWeights" />

        <ImageView
            android:id="@+id/widget_location_icon"
            android:layout_width="@dimen/widget_icon_location"
            android:layout_height="@dimen/widget_icon_location"
            android:layout_marginStart="@dimen/widget_spacing_xs"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_location"
            android:visibility="gone"
            tools:visibility="visible" />
        </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_observation_time"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_spacing_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_secondary"
            android:textSize="@dimen/widget_text_caption2" />

        <FrameLayout
            android:id="@+id/widget_refresh"
            android:visibility="gone"
            android:layout_width="@dimen/widget_icon_action_target_large"
            android:layout_height="@dimen/widget_icon_action_target_large"
            android:layout_marginStart="@dimen/widget_spacing_xs"
            android:contentDescription="@string/widget_refresh"
            android:padding="@dimen/widget_spacing_xs">
            <ImageView
                android:id="@+id/widget_refresh_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_refresh"
                android:tint="@color/widget_icon_tint" />
            <ProgressBar
                android:id="@+id/widget_refresh_progress"
                style="@style/Widget.RefreshProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- The Android-only notice: a full-width row so it never shares the
         header's width with the town. -->
    <TextView
        android:id="@+id/widget_stale"
        style="@style/Widget.Badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_large_tight_section_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_text_temperature" />

            <TextView
                android:id="@+id/widget_apparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="@dimen/widget_text_caption2_min"
                android:autoSizeMaxTextSize="@dimen/widget_text_caption"
                android:autoSizeStepGranularity="1sp"
                android:maxLines="1"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <!-- Same outer EXACT / inner AT_MOST trailing group as the roomy
                 layout; removing the parent loses its trailing alignment. -->
            <LinearLayout
                tools:ignore="UselessParent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="@dimen/widget_icon_small"
                android:layout_height="@dimen/widget_icon_small"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_weather"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_spacing_sm"
                android:autoSizeMaxTextSize="@dimen/widget_text_headline"
                android:autoSizeMinTextSize="@dimen/widget_text_headline_min"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_headline" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_forecast_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/widget_large_tight_section_gap"
        android:baselineAligned="false"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_large_tight_section_gap"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_humidity"
                android:paddingTop="@dimen/widget_grid_label_inset"
                android:ellipsize="end"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_caption2" />

            <TextView
                android:id="@+id/widget_grid_humidity_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:autoSizeMaxTextSize="@dimen/widget_text_grid_value"
        android:autoSizeMinTextSize="@dimen/widget_text_grid_value_min"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:textSize="@dimen/widget_text_grid_value" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_grid_column_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_rain"
                android:paddingTop="@dimen/widget_grid_label_inset"
                android:ellipsize="end"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_caption2" />

            <TextView
                android:id="@+id/widget_grid_rain_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:autoSizeMaxTextSize="@dimen/widget_text_grid_value"
        android:autoSizeMinTextSize="@dimen/widget_text_grid_value_min"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:textSize="@dimen/widget_text_grid_value" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_grid_column_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_grid_sun_label"
                android:paddingTop="@dimen/widget_grid_label_inset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_caption2" />

            <TextView
                android:id="@+id/widget_grid_sun_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:autoSizeMaxTextSize="@dimen/widget_text_grid_value"
        android:autoSizeMinTextSize="@dimen/widget_text_grid_value_min"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:textSize="@dimen/widget_text_grid_value" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_grid_row_gap_tight"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_wind"
                android:paddingTop="@dimen/widget_grid_label_inset"
                android:ellipsize="end"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_caption2" />

            <TextView
                android:id="@+id/widget_grid_wind_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:autoSizeMaxTextSize="@dimen/widget_text_grid_value"
        android:autoSizeMinTextSize="@dimen/widget_text_grid_value_min"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:textSize="@dimen/widget_text_grid_value" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_grid_column_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_station"
                android:paddingTop="@dimen/widget_grid_label_inset"
                android:ellipsize="end"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_caption2" />

            <TextView
                android:id="@+id/widget_grid_station_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:autoSizeMaxTextSize="@dimen/widget_text_grid_value"
        android:autoSizeMinTextSize="@dimen/widget_text_grid_value_min"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:textSize="@dimen/widget_text_grid_value" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
