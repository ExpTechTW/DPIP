<?xml version="1.0" encoding="utf-8"?>
<!--
  Medium (two-row) layout: a restatement of iOS `MediumCurrentWeatherView`
  (`ios/DPIPWidgets/DPIPWidgets.swift`, lines 285–401) — the town leading and
  the observation time trailing, then the 38 pt temperature with the apparent
  temperature inline on the leading edge and the condition glyph and name on the
  trailing one, then five hourly columns. (iOS medium draws five.)

  Every dimension is budgeted against the ~172 dp a 4x2 launcher cell reports:
  `WidgetLayoutFitTest` lays the applied view out at 250x172 and 320x172 dp with
  real font metrics and fails on any overflow. That is why this layout uses
  `widget_padding_medium`; the square and large layouts, which have room, use the
  16 dp the WidgetKit content inset does.

  There is no divider. iOS draws none, and the divider this layout used to carry
  was the most visible thing that made it read as a different widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="@dimen/widget_padding_medium"
    tools:ignore="DisableBaselineAlignment,UselessLeaf,UseAppTint,UseCompoundDrawables">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- The weighted outer budget bounds long towns; the wrap_content
             inner group keeps the location mark beside the text, not the clock. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UselessParent">
        <TextView
            android:id="@+id/widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/widget_text_headline"
            android:autoSizeMinTextSize="@dimen/widget_text_headline_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_text_headline"
            tools:ignore="NestedWeights" />

        <ImageView
            android:id="@+id/widget_location_icon"
            android:layout_width="@dimen/widget_icon_location"
            android:layout_height="@dimen/widget_icon_location"
            android:layout_marginStart="@dimen/widget_spacing_xs"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_location"
            android:visibility="gone"
            tools:visibility="visible" />
        </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_observation_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_spacing_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_secondary"
            android:textSize="@dimen/widget_text_caption2" />

        <FrameLayout
            android:id="@+id/widget_refresh"
            android:layout_width="@dimen/widget_icon_action_target"
            android:layout_height="@dimen/widget_icon_action_target"
            android:layout_marginStart="@dimen/widget_spacing_xs"
            android:contentDescription="@string/widget_refresh"
            android:padding="@dimen/widget_spacing_xs">
            <ImageView
                android:id="@+id/widget_refresh_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_refresh"
                android:tint="@color/widget_icon_tint" />
            <ProgressBar
                android:id="@+id/widget_refresh_progress"
                style="@style/Widget.RefreshProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- Status never competes with the town/date/actions for header width. -->
    <TextView
        android:id="@+id/widget_stale"
        style="@style/Widget.Badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/widget_medium_section_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="@dimen/widget_text_temperature_compact"
                android:autoSizeMaxTextSize="@dimen/widget_text_temperature_medium"
                android:autoSizeStepGranularity="1sp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_text_temperature_medium" />

            <TextView
                android:id="@+id/widget_apparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_spacing_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_caption" />
        </LinearLayout>

        <!-- Bound the condition to the remaining width. The single nested
             weight is deliberate: the outer vertical weight balances spare
             height, this horizontal weight budgets text width. Both axes are
             pinned by WidgetLayoutFitTest; removing either clips narrow cells. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables,NestedWeights">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="@dimen/widget_icon_medium"
                android:layout_height="@dimen/widget_icon_medium"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_spacing_sm"
                android:autoSizeMaxTextSize="@dimen/widget_text_body"
                android:autoSizeMinTextSize="@dimen/widget_text_caption2_min"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_secondary"
                android:textSize="@dimen/widget_text_body" />
        </LinearLayout>
    </LinearLayout>

    <!-- The current row absorbs extra height; keep the hours on the bottom
         edge rather than leaving unused space after top-aligned columns. -->
    <LinearLayout
        android:id="@+id/widget_forecast_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_medium_section_gap"
        android:baselineAligned="false"
        android:orientation="horizontal" />
</LinearLayout>
