<?xml version="1.0" encoding="utf-8"?>
<!--
  The next hour's rain, one bar per minute — the home sheet's trend card
  (`home_rain_trend_section.dart`) as a launcher can draw it.

  `RemoteViews` cannot host a chart, so each minute is an ImageView holding a
  bottom-anchored clip drawable whose level `WidgetRenderer` sets
  (`setImageLevel`): the height is the share of the 35 mm ceiling, the colour
  comes from `@color/widget_rain_bar` and so follows the night theme in the
  launcher's own process, and nothing is rasterised in this one. A minute the
  forecast does not cover gets the grey no-data bar instead.

  Included, `gone`, beside every forecast row: the renderer shows either the
  hourly row or this, never both.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_rain_chart"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/widget_medium_section_gap"
    android:focusable="true"
    android:gravity="center_vertical"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/widget_rain_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="@dimen/widget_text_caption"
        android:autoSizeMinTextSize="@dimen/widget_text_caption2_min"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="@dimen/widget_text_caption" />

    <LinearLayout
