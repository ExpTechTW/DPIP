<?xml version="1.0" encoding="utf-8"?>
<!--
  The smallest box the metadata promises (110x110 dp), and only that box.

  A 110 dp square cannot hold the square layout's header, its 42 pt temperature
  and its metric row at the same time — the old revision squeezed the full-size
  layout with 8 dp type instead, which is why it read as mostly empty whitespace
  around unreadable text. This keeps the same hierarchy at the sizes that fit:
  the town and the refresh action, the observation time, the notice, then the condition
  glyph and the temperature in the space that is left.

  Both humidity and rainfall remain present; only the condition name is omitted.
  `WidgetPresentation.sizeClass` only selects it below the measured normal
  budget, so a launcher that reports ~120x172 dp still gets
  the full square layout. `WidgetLayoutFitTest` renders this one at exactly
  110x110 dp, fresh and stale, at font scale 1.0 and 1.3.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="@dimen/widget_padding_compact"
    tools:ignore="DisableBaselineAlignment,UselessLeaf,UseAppTint,UseCompoundDrawables">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UselessParent">
        <TextView
            android:id="@+id/widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/widget_text_headline_compact"
            android:autoSizeMinTextSize="@dimen/widget_text_headline_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_text_headline_compact" />

        <ImageView
            android:id="@+id/widget_location_icon"
            android:layout_width="@dimen/widget_icon_location"
            android:layout_height="@dimen/widget_icon_location"
            android:layout_marginStart="@dimen/widget_spacing_xs"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_location"
            android:visibility="gone"
            tools:visibility="visible" />
        </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_refresh"
            android:visibility="gone"
            android:layout_width="@dimen/widget_icon_action_target_compact"
            android:layout_height="@dimen/widget_icon_action_target_compact"
            android:layout_marginStart="@dimen/widget_spacing_xs"
            android:contentDescription="@string/widget_refresh"
            android:padding="@dimen/widget_spacing_xs">
            <ImageView
                android:id="@+id/widget_refresh_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_refresh"
                android:tint="@color/widget_icon_tint" />
            <ProgressBar
                android:id="@+id/widget_refresh_progress"
                style="@style/Widget.RefreshProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_observation_time"
        android:includeFontPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_secondary"
        android:textSize="@dimen/widget_text_caption2" />

    <TextView
        android:id="@+id/widget_stale"
        style="@style/Widget.Badge"
        android:includeFontPadding="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="@dimen/widget_icon_compact"
            android:layout_height="@dimen/widget_icon_compact"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_temperature"
            tools:ignore="NestedWeights"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/widget_spacing_sm"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/widget_text_headline_min"
            android:autoSizeMaxTextSize="@dimen/widget_text_temperature_compact"
            android:autoSizeStepGranularity="1sp"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_text_temperature_compact" />
    </LinearLayout>

    <!-- Both readings survive even when the full iOS-sized face cannot fit. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_humidity"
            android:layout_width="@dimen/widget_icon_location"
            android:layout_height="@dimen/widget_icon_location"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_humidity" />
        <TextView
            android:id="@+id/widget_humidity_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/widget_text_metric_min"
            android:autoSizeMaxTextSize="@dimen/widget_text_caption2"
            android:textSize="@dimen/widget_text_caption2"
            android:textColor="@color/widget_secondary" />
        <ImageView
            android:id="@+id/widget_rain"
            android:layout_width="@dimen/widget_icon_location"
            android:layout_height="@dimen/widget_icon_location"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_raindrop" />
        <TextView
            android:id="@+id/widget_rain_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/widget_text_metric_min"
            android:autoSizeMaxTextSize="@dimen/widget_text_caption2"
            android:textSize="@dimen/widget_text_caption2"
            android:textColor="@color/widget_secondary" />
    </LinearLayout>
</LinearLayout>
